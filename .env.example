# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (required): Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where lessons are read from: "pool" (default; public.exercises_pool, falling back to
# content/lessons) or "registry" (content/lessons only — the rollback).
# LESSON_SOURCE=pool

# Product analytics (optional): PostHog public project key and ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-ingestion-host

# Error reporting (optional): Sentry project DSN. Nothing is sent while it's empty.
NEXT_PUBLIC_SENTRY_DSN=

# SUPABASE_DB_URL is a superuser credential for the curriculum import. Keep it out of this file:
# see docs/exercise-pool.md.

# Reminders. Generate the push keys once with `bunx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, as mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com
# The project's secret key (Project settings → API keys). Server only: the reminder job uses it to
# read who is due. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# A long random string; pg_cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Email reminders stay off until both are set; the sender must be on a domain verified in Resend.
# RESEND_API_KEY=
# REMINDER_FROM_EMAIL="Klarlingo <reminders@your-domain.com>"

# AI features (Explain my answer, roleplays). Off while unset. Server only.
# ANTHROPIC_API_KEY=
# Optional: another Claude model id; the default is claude-opus-5-5.
# KLARLINGO_AI_MODEL=

# Recorded speech (ElevenLabs). Voice ids go in content/courses/<id>/course.ts. Server only.
# Without a key, lines already recorded still play and the rest use the browser's voice.
# ELEVENLABS_API_KEY=
# Characters the whole app may record on demand per UTC day (default 100000).
# TTS_DAILY_CHAR_BUDGET=100000
